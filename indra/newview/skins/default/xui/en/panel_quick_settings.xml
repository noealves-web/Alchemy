   enabled="false"
   top_pad="-16"
   height="20"
   left="93"
   right="-68"
   follows="left|top|right"
   layout="topleft"
   increment="0.001"
   initial_value="0.0"
   name="hover_slider_bar"/>
  <spinner
   enabled="false"
   top_pad="-21"
   height="20"
   label_width="0"
   right="-8"
   decimal_digits="3"
   follows="top|right"
   layout="topleft"
   max_val="2.0"
   min_val="-2.0"
   width="55"
   increment="0.001"
   name="hover_spinner"
   control_name="AvatarHoverOffsetZ"/>
</panel>
