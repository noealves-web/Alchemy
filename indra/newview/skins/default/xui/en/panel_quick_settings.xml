<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
 class="quick_settings"
 layout="topleft"
 width="300"
 height="319"
 name="quick_settings">
  <text
   follows="left|top"
   height="18"
   left="10"
   top="8"
   width="280"
   layout="topleft"
   value="Graphics profile"
   name="graphics_profile_label"/>
  <button
   follows="left|top"
   height="24"
   left="10"
   top_pad="3"
   width="88"
   layout="topleft"
   label="Light"
   tool_tip="Best for integrated graphics; PBR remains enabled"
   name="profile_light_btn"/>
  <button
   follows="left|top"
   height="24"
   left_pad="8"
   top_delta="0"
   width="88"
   layout="topleft"
   label="Balanced"
   tool_tip="A practical balance of image quality and frame rate"
   name="profile_balanced_btn"/>
  <button
   follows="left|top"
   height="24"
   left_pad="8"
   top_delta="0"
   width="88"
   layout="topleft"
   label="PBR Max"
   tool_tip="Maximum PBR quality for photography and powerful GPUs"
   name="profile_pbr_btn"/>
  <text
   follows="left|top"
   height="18"
   left="10"
   top_pad="9"
   width="280"
   layout="topleft"
   value="Environment"
   name="environment_label"/>
  <button
   follows="left|top"
   height="24"
   left="10"
   top_pad="3"
   width="62"
   layout="topleft"
   label="Shared"
   tool_tip="Use the parcel or region environment"
   name="environment_shared_btn"/>
  <button
   follows="left|top"
   height="24"
   left_pad="7"
   top_delta="0"
   width="62"
   layout="topleft"
   label="Midday"
   name="environment_midday_btn"/>
  <button
   follows="left|top"
   height="24"
   left_pad="7"
   top_delta="0"
   width="62"
   layout="topleft"
   label="Sunset"
   name="environment_sunset_btn"/>
  <button
   follows="left|top"
   height="24"
   left_pad="7"
   top_delta="0"
   width="62"
   layout="topleft"
   label="Night"
   name="environment_midnight_btn"/>
  <text
   follows="left|top"
   height="15"
   left="10"
   top_pad="9"
   width="120"
   layout="topleft"
   value="Draw Distance:"
   name="draw_distance_label"/>
  <slider_bar
   top_pad="-16"
   height="20"
   increment="32"
   initial_value="96"
   follows="left|top|right"
   layout="topleft"
   max_val="512"
   min_val="64"
   left="93"
   right="-68"
   name="draw_dist_slider_bar"
   control_name="RenderFarClip"/>
  <spinner
   top_pad="-21"
   height="20"
   label=""
   label_width="0"
   right="-8"
   decimal_digits="0"
   follows="top|right"
   layout="topleft"
   max_val="512"
   min_val="64"
   width="55"
   increment="32"
   name="draw_dist_spinner"
   control_name="RenderFarClip"/>
  <text
   follows="left|top"
   height="15"
   left="10"
   top_pad="3"
   width="120"
   layout="topleft"
   value="Level of Detail:"
   name="lod_label"/>
  <slider_bar
   top_pad="-16"
   height="20"
   increment="0.1"
   initial_value="96"
   follows="left|top|right"
   layout="topleft"
   max_val="4.0"
   min_val="1.0"
   left="93"
   right="-68"
   name="lod_slider_bar"
   control_name="RenderVolumeLODFactor"/>
  <spinner
   top_pad="-21"
   height="20"
   label_width="0"
   right="-8"
   decimal_digits="2"
   follows="top|right"
   layout="topleft"
   max_val="4.0"
   min_val="1.0"
   width="55"
   increment="0.1"
   name="lod_spinner"
   control_name="RenderVolumeLODFactor"/>
  <text
   follows="left|top"
   height="15"
   left="10"
   top_pad="3"
   width="120"
   layout="topleft"
   value="Max Particles:"
   name="max_particles_label"/>
